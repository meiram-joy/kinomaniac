# Образец настроек. Копия под именем .env читается kino.py, check.py и tools/*;
# сам .env в git не попадает. Без .env всё работает на локальной qwen3.5:4b в Ollama.

# Ключ нужен только для облачной модели
OPENAI_API_KEY=

# Другая модель или сервер (по умолчанию qwen3.5:4b и http://127.0.0.1:11434/v1)
# KINO_MODEL=gpt-6-luna
# KINO_BASE_URL=https://api.openai.com/v1
